    {
      "name": "an upload never replaces a queued file or the file printing: it is stored under the next free name",
      "selected": "walnut",
      "steps": [
        { "set": { "walnut": { "files": ["q.gcode", "p.gcode"], "queued": ["q.gcode"], "state": "printing", "filename": "p.gcode" } } },
        { "upload": { "printer": "$walnut", "name": "q.gcode" }, "expect": { "result": { "path": "q_2.gcode" } }, "calls": ["upload walnut q_2.gcode"] },
        { "upload": { "printer": "$walnut", "name": "p.gcode" }, "expect": { "result": { "path": "p_2.gcode" } }, "calls": ["upload walnut p_2.gcode"] }
      ]
    },
    {
      "name": "an upload never replaces a file this session did not write; one it wrote, it replaces",
