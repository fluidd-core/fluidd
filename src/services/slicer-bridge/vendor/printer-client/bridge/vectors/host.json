        { "upload": { "printer": "$walnut", "name": "a_3.gcode" }, "expect": { "result": { "path": "a_3.gcode" } }, "calls": ["upload walnut a_3.gcode"] },
        { "reload": true },
        { "upload": { "printer": "$walnut", "name": "a_3.gcode" }, "expect": { "result": { "path": "a_3_2.gcode" } }, "calls": ["upload walnut a_3_2.gcode"] }
      ]
    },
    {
      "name": "Plate is clear: asked after a job that put material on the plate, whatever the frame says",
      "selected": "walnut",
      "steps": [
        { "upload": { "printer": "$walnut", "name": "a.gcode" }, "expect": { "result": { "path": "a.gcode" } }, "calls": ["upload walnut a.gcode"] },
        { "request": { "op": "print.request", "params": { "printer": "$walnut", "paths": ["a.gcode"], "mode": "start", "plateClear": "not-needed" } }, "dialog": "print", "asked": "not-needed", "expect": { "result": { "decision": "started" } }, "calls": ["start walnut a.gcode"] },
