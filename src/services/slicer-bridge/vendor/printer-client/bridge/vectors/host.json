        { "request": { "op": "moonraker.read", "params": { "printer": "$walnut", "method": "server.gcode_store", "params": { "count": 1000 } } }, "expect": { "error": "bad-request" } },
        { "request": { "op": "moonraker.read", "params": { "printer": "$walnut", "method": "server.files.metadata", "params": { "filename": "../config/x.cfg" } } }, "expect": { "error": "bad-request" } }
      ]
