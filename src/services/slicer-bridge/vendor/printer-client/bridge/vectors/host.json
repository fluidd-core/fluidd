        { "reload": true },
        { "request": { "op": "print.request", "params": { "printer": "$walnut", "paths": ["a.gcode"], "mode": "start", "plateClear": "not-needed" } }, "expect": { "error": "not-allowed" } }
      ]
    },
    {
      "name": "a capability the welcome did not grant",
      "selected": "walnut",
      "capabilities": ["printer", "status", "gcode", "moonraker.read"],
      "steps": [
