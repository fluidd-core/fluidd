    { "name": "files.upload with a path field", "message": { "v": 1, "id": 26, "op": "files.upload", "params": { "printer": "$walnut", "name": "a.gcode", "size": 12, "checksum": "a515612f48fac2c3870ef43324ac2096c67273fc4df8488cd3d27cb15dff2c95", "bytes": { "$bytes": 12 }, "path": "sub" } }, "expect": { "error": "bad-request", "re": 26 } },
