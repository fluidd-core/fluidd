    { "name": "printer.material: no colour (the host keeps the printer's own)", "message": { "v": 1, "event": "printer.material", "printer": "$oak", "data": { "material": "PLA-CF", "colour": null } }, "expect": { "event": "printer.material", "printer": "$oak", "material": { "material": "PLA-CF", "colour": null } } },
    { "name": "printer.material: the colour left out", "message": { "v": 1, "event": "printer.material", "printer": "$oak", "data": { "material": "TPU" } }, "expect": { "event": "printer.material", "printer": "$oak", "material": { "material": "TPU", "colour": null } } },
    { "name": "printer.material naming no printer", "message": { "v": 1, "event": "printer.material", "printer": null, "data": { "material": "PLA", "colour": null } }, "expect": "ignored" },
    { "name": "printer.material naming a printer that is not a key", "message": { "v": 1, "event": "printer.material", "printer": "Walnut", "data": { "material": "PLA", "colour": null } }, "expect": "ignored" },
    { "name": "printer.material with no material", "message": { "v": 1, "event": "printer.material", "printer": "$walnut", "data": { "colour": "#FFFFFF" } }, "expect": "ignored" },
    { "name": "printer.material whose material would break a G-code line", "message": { "v": 1, "event": "printer.material", "printer": "$walnut", "data": { "material": "PLA'\"; FIRMWARE_RESTART", "colour": null } }, "expect": "ignored" },
    { "name": "printer.material whose material is too long", "message": { "v": 1, "event": "printer.material", "printer": "$walnut", "data": { "material": "PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP", "colour": null } }, "expect": "ignored" },
    { "name": "printer.material whose colour is a name", "message": { "v": 1, "event": "printer.material", "printer": "$walnut", "data": { "material": "PLA", "colour": "teal" } }, "expect": "ignored" },
