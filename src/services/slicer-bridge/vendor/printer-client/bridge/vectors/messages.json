    { "name": "an answer, not an event", "message": { "v": 1, "re": 4, "event": "printer.material", "printer": "$walnut", "data": { "material": "PLA" } }, "expect": "ignored" },
    { "name": "version 2", "message": { "v": 2, "event": "printer.material", "printer": "$walnut", "data": { "material": "PLA" } }, "expect": "ignored" }
