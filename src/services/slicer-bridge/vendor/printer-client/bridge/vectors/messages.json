    { "name": "a generic call", "message": { "v": 1, "id": 23, "op": "moonraker.call", "params": { "printer": "$walnut", "method": "printer.print.start" } }, "expect": { "error": "unsupported", "re": 23 } },
    { "name": "files.upload", "message": { "v": 1, "id": 24, "op": "files.upload", "params": { "printer": "$walnut", "name": "Benchy_PLA_44m.gcode", "size": 12, "checksum": "a515612f48fac2c3870ef43324ac2096c67273fc4df8488cd3d27cb15dff2c95", "bytes": { "$bytes": 12 } } }, "expect": { "op": "files.upload", "name": "Benchy_PLA_44m.gcode", "size": 12 } },
