git diff --cached --name-only --diff-filter=ACMR -z \
  | grep -izE '^src/globals\.ts$|\.(vue|svg)$' \
  | xargs -0 -r node tools/svgo.mjs

git diff --cached --name-only --diff-filter=ACMR -z \
  | xargs -0 -r pnpm exec oxfmt --no-error-on-unmatched-pattern

git update-index --again

git diff --cached --name-only --diff-filter=ACMR -z \
  | grep -izE '\.(js|mjs|cjs|ts|mts|cts|vue)$' \
  | xargs -0 -r pnpm exec oxlint --deny-warnings --no-error-on-unmatched-pattern

git diff --cached --name-only --diff-filter=ACMR -z \
  | grep -izE '\.vue$' \
  | xargs -0 -r pnpm exec eslint --max-warnings 0
