{
  "name": "fluidd",
  "version": "1.38.1",
  "private": true,
  "description": "fluidd, a klipper web client.",
  "keywords": [
    "klipper"
  ],
  "homepage": "https://github.com/fluidd-core/fluidd#readme",
  "bugs": {
    "url": "https://github.com/fluidd-core/fluidd/issues"
  },
  "license": "GPL-3.0",
  "author": {
    "name": "Craig Bassett"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluidd-core/fluidd.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve:prod": "vite preview --port 5000",
    "serve:docs": "cd ./docs && zensical serve",
    "lint": "oxlint && eslint .",
    "format": "oxfmt",
    "prepare": "husky",
    "release": "commit-and-tag-version",
    "release:major": "pnpm run release --release-as major",
    "release:minor": "pnpm run release --release-as minor",
    "release:patch": "pnpm run release --release-as patch",
    "release:rc": "pnpm run release --prerelease rc",
    "test": "pnpm run test:unit",
    "test:unit": "vitest",
    "type-check": "vue-tsc --build --noEmit"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.3.2",
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@irojs/iro-core": "^1.2.1",
    "@jaames/iro": "^5.5.2",
    "axios": "^1.21.1",
    "consola": "^3.4.2",
    "dompurify": "catalog:",
    "echarts": "catalog:",
    "echarts-gl": "^2.1.0",
    "hls.js": "^1.7.4",
    "ipaddr.js": "^2.5.0",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.18.1",
    "marked": "^18.3.0",
    "marked-base-url": "^1.1.11",
    "md5": "^2.3.0",
    "monaco-editor": "^0.58.0",
    "panzoom": "^9.4.4",
    "qr-scanner": "^1.4.2",
    "qrcode.vue": "^1.7.0",
    "semver": "^7.8.6",
    "shlex": "^3.0.1",
    "sortablejs": "^1.15.7",
    "uuid": "^14.0.3",
    "vue": "catalog:",
    "vue-class-component": "^7.2.6",
    "vue-echarts": "^7.0.3",
    "vue-i18n": "^8.28.2",
    "vue-inline-svg": "^2.1.4",
    "vue-json-viewer": "^2.2.22",
    "vue-meta": "^2.4.0",
    "vue-property-decorator": "^9.1.2",
    "vue-router": "^3.6.5",
    "vue2-touch-events": "^3.2.3",
    "vuetify": "^2.7.2",
    "vuetify-confirm": "^2.0.6",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@originjs/vite-plugin-content": "^1.0.5",
    "@pedrolamas/plugin-vue2": "^2.4.1",
    "@tsconfig/node26": "^26.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/md5": "^2.3.6",
    "@types/node": "^26.6.10",
    "@types/semver": "^7.8.0",
    "@types/sortablejs": "^1.15.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^1.3.6",
    "@vue/tsconfig": "^0.9.1",
    "commit-and-tag-version": "^13.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-vue": "^10.12.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "mockdate": "^3.0.5",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "sass-embedded": "^1.108.2",
    "svgo": "^4.1.0",
    "typescript": "catalog:",
    "unplugin-vue-components": "^30.0.0",
    "vite": "catalog:",
    "vite-plugin-checker": "^1.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2",
    "vue-debounce-decorator": "^1.0.1",
    "vue-template-compiler": "^2.7.16",
    "vue-tsc": "~3.0.10",
    "workbox-build": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-recipes": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^24 || ^26"
  }
}
